# Local SMTP settings for the quote form. Gitignored; never commit this file.
#
# This reuses the same Gmail account already configured for the owner's other
# site. A dedicated mailbox for kraftboxpack.com would be preferable — see
# ENVIRONMENT_VARIABLES.md.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USER=

# Gmail requires a 16-character App Password, not the account password.
SMTP_PASS=

# Where quote requests are delivered.
SMTP_TO=

SMTP_FROM_NAME=Kraft Box Pack

# Gmail rewrites the From header to SMTP_USER unless the address is verified
# under Gmail -> Settings -> Accounts -> "Send mail as". Until info@kraftboxpack.com
# is verified there, mail will visibly come from the Gmail address.
SMTP_FROM_EMAIL=info@kraftboxpack.com
