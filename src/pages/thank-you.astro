---
import PageLayout from '../layouts/PageLayout.astro';
import { CONTACT } from '../data/site';
---
<PageLayout
  title="Thank you | Kraft Box Pack"
  description="Your request has been received. We reply within one business day."
  path="/thank-you/"
  heading="Thank you"
  noindex
>
  <p>
    Your request has been received. One of our packaging specialists will reply within
    one business day with pricing and a structural recommendation.
  </p>
  <p>
    If it is urgent, call <a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneDisplay}</a> or email
    <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.
  </p>
  <p><a href="/products/">Browse all custom kraft boxes</a></p>
</PageLayout>
