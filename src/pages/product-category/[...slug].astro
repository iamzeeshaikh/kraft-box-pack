---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import FaqAccordion from '../../components/product/FaqAccordion.astro';
import { categories, products, productsIn } from '../../data/content';
import { primary } from '../../lib/images';
import * as schema from '../../lib/schema';
import { SEO_OVERRIDES } from '../../data/seo-overrides';
import { CATEGORY_CONTENT } from '../../data/category-content';

export function getStaticPaths() {
  return categories.map((category) => ({
    // `url` is `/product-category/a/b/`, and the rest parameter wants `a/b`.
    params: { slug: category.url.replace('/product-category/', '').replace(/\/$/, '') },
    props: { category },
  }));
}

const { category } = Astro.props;
const items = productsIn(category.slug);

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Products', url: '/products/' },
  ...(category.parentRef ? [{ name: category.parentRef.name, url: category.parentRef.url }] : []),
  { name: category.name, url: category.url },
];

/**
 * WordPress published two categories both named "Kraft Cosmetic Boxes" — one
 * top-level with 2 products, one nested under Kraft Packaging Boxes with the
 * misspelt slug "karft" and 9 products. Neither had ever earned a click, and
 * the correctly-spelled URL already ranked far better (position 15.6 against
 * 43.1) on a fifth of the products.
 *
 * They are now merged: the nine products moved to the correct category, the
 * misspelt route is no longer built, and a 301 sends its URL to the merged
 * page. Every category self-canonicalises, so the cross-canonical this
 * template used to carry is gone.
 */

/* Hand-written metadata for the categories that earn impressions; the
   generated pattern remains the fallback for the rest. */
const seo = SEO_OVERRIDES[category.url];
const title =
  seo?.title ||
  `${category.name} | Custom Wholesale ${category.name.includes('Boxes') ? 'Packaging' : 'Boxes'}`;
const description = seo?.description || category.metaDescription;

/* Written content for this category. Every category imported with an empty
   description, so the page fell back to one generated sentence and all
   seventeen read alike. */
const content = CATEGORY_CONTENT[category.slug];

/* Each listed product as a Product node with its rating, the way the
   WordPress archive published this page. */
const byUrl = new Map(products.map((p) => [p.url, p]));
const productNodes = category.items.map((i) => {
  const p = byUrl.get(i.url)!;
  return schema.productSummary(p, primary(p.images)?.image.src);
});

const pageSchema = [
  ...schema.categoryNode(category, productNodes),
  schema.breadcrumbs(category.url, crumbs),
  ...(content?.faqs?.length ? [schema.faqPage(category.url, content.faqs)] : []),
];
---

<BaseLayout
  title={title}
  description={description}
  path={category.url}
  pageType="category"
  itemName={category.name}
  schema={pageSchema}
>
  <Breadcrumbs crumbs={crumbs} />

  <div class="wrap cat">
    <h1>{category.name}</h1>
    {content ? (
      <div class="cat__intro prose">{content.intro.map((p) => <p>{p}</p>)}</div>
    ) : category.description ? (
      <div class="prose cat__intro" set:html={category.description} />
    ) : (
      <p class="cat__intro">
        {items.length} custom {category.name.toLowerCase()} made to your dimensions,
        with free design assistance and an 8-10 business day turnaround.
      </p>
    )}

    {category.children.length > 0 && (
      <nav class="cat__children" aria-label="Subcategories">
        <h2>Browse by type</h2>
        <ul role="list">
          {category.children.map((c) => <li><a href={c.url} class="btn btn--ghost">{c.name}</a></li>)}
        </ul>
      </nav>
    )}
  </div>

  <section class="section" aria-labelledby="cat-products">
    <div class="wrap">
      <h2 id="cat-products" class="visually-hidden">
        {items.length} products in {category.name}
      </h2>
      <ProductGrid products={items} />
    </div>
  </section>

  {content && (
    <section class="section section--alt" aria-labelledby="cat-guide">
      <div class="wrap cat__guide">
        <h2 id="cat-guide" class="cat__guide-head">
          Choosing {category.name.toLowerCase()}
        </h2>
        <div class="cat__blocks">
        {content.sections.map((s) => (
          <div class:list={['cat__block', 'prose', (s.table || s.list) && 'cat__block--wide']}>
            <h2>{s.h2}</h2>
            {/* set:html so a contextual link can sit inside the sentence it
                belongs to. Interpolating this as text put every link on the
                page into the single trailing `link` paragraph instead, which
                left roughly one link per 900 words of guide copy.
                Section bodies are authored in category-content.ts and carry at
                most one <a> each; scripts/link-audit.py enforces that. */}
            {s.body.map((p) => <p set:html={p} />)}
            {/* No links in list items: a list is a short block, and one link
                per item reads as a cluster however it is written. */}
            {s.list && <ul>{s.list.map((li) => <li>{li}</li>)}</ul>}
            {s.table && (
              <div class="table-scroll">
                <table>
                  <caption>{s.table.caption}</caption>
                  <thead>
                    <tr>{s.table.head.map((h) => <th scope="col">{h}</th>)}</tr>
                  </thead>
                  <tbody>
                    {s.table.rows.map((r) => (
                      <tr>
                        {r.map((cell, i) =>
                          i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>,
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        ))}
        </div>
        {/* One contextual link out of the page, in its own paragraph so the
            one-link-per-paragraph rule holds structurally. */}
        {content.link && (
          <p class="cat__link prose">
            {content.link.lead}
            <a href={content.link.href}>{content.link.anchor}</a>
            {content.link.tail}
          </p>
        )}
      </div>
    </section>
  )}

  {content?.faqs?.length > 0 && (
    <section class="section" aria-labelledby="cat-faq">
      <div class="wrap cat__faq">
        <h2 id="cat-faq">{category.name} questions</h2>
        <FaqAccordion faqs={content.faqs} />
      </div>
    </section>
  )}

  <QuoteBand
    heading={`Need a quote for ${category.name.toLowerCase()}?`}
    body="Send your dimensions, quantity and artwork and we will price it for you."
  />
</BaseLayout>

<style>
  .cat { padding-block: clamp(1.5rem, 1.2rem + 1.4vw, 2.5rem) 0; }
  .cat h1 { margin-bottom: 0.4em; }
  .cat__intro { color: var(--ink-soft); max-width: 72ch; }

  .cat__children { margin-top: 1.5rem; }
  .cat__children h2 { font-size: var(--step-1); }
  .cat__children ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cat__children li { margin: 0; }

  /* The guide block.
     Every section here used to be an unstyled div stacked on the alt
     background, which rendered as one undifferentiated slab — six headings and
     their prose running together with nothing to separate them and no title on
     the block at all, because its only h2 was visually-hidden. The content was
     there and read as though nothing had been added.
     Cards on the alt background give each section an edge, and the heading is
     now visible so the block announces what it is. Tokens only: no new color,
     radius or type step is introduced here. */
  /* No standfirst under this heading on purpose: a line of lead-in copy would
     be identical on all sixteen categories, and this file's whole argument is
     that nothing on these pages should be. */
  .cat__guide-head {
    font-size: var(--step-3);
    margin-bottom: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .cat__blocks {
    display: grid;
    gap: var(--gap);
  }

  /* Two columns once there is room for two comfortable measures. Sections
     carrying a table or a list span both, because a table squeezed into half a
     column scrolls sideways and a list loses its scannability. */
  @media (min-width: 60rem) {
    .cat__blocks { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
    .cat__block--wide { grid-column: 1 / -1; }
  }

  .cat__block {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.1rem, 0.9rem + 0.9vw, 1.75rem);
    /* A grid item defaults to min-width:auto, so a table inside one refuses to
       shrink below its own content and pushes the page sideways. This is the
       whole of the overflow a11y.mjs caught at 360 and 390px; minmax(0,1fr)
       above fixes the track and this fixes the item. */
    min-width: 0;
  }

  /* A kraft rule above each heading, which is what visually separates one
     section from the next when several sit in a column. */
  .cat__block h2 {
    font-size: var(--step-2);
    margin-top: 0;
    margin-bottom: 0.5em;
    padding-top: 0.75rem;
    border-top: 3px solid var(--kraft-light);
    display: inline-block;
  }

  .cat__block > :last-child { margin-bottom: 0; }

  .cat__block table { margin-bottom: 0; }

  .cat__link {
    margin-top: var(--gap);
    padding-left: 1rem;
    border-left: 3px solid var(--kraft-light);
  }
</style>
