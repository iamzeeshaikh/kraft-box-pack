---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import FaqAccordion from '../../components/product/FaqAccordion.astro';
import { categories, productsIn } from '../../data/content';
import * as schema from '../../lib/schema';
import { SEO_OVERRIDES } from '../../data/seo-overrides';
import { CATEGORY_CONTENT } from '../../data/category-content';

export function getStaticPaths() {
  return categories.map((category) => ({
    // `url` is `/product-category/a/b/`, and the rest parameter wants `a/b`.
    params: { slug: category.url.replace('/product-category/', '').replace(/\/$/, '') },
    props: { category },
  }));
}

const { category } = Astro.props;
const items = productsIn(category.slug);

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Products', url: '/products/' },
  ...(category.parentRef ? [{ name: category.parentRef.name, url: category.parentRef.url }] : []),
  { name: category.name, url: category.url },
];

/**
 * WordPress published two categories both named "Kraft Cosmetic Boxes" — one
 * top-level with 2 products, one nested under Kraft Packaging Boxes with the
 * misspelt slug "karft" and 9 products. Neither had ever earned a click, and
 * the correctly-spelled URL already ranked far better (position 15.6 against
 * 43.1) on a fifth of the products.
 *
 * They are now merged: the nine products moved to the correct category, the
 * misspelt route is no longer built, and a 301 sends its URL to the merged
 * page. Every category self-canonicalises, so the cross-canonical this
 * template used to carry is gone.
 */

/* Hand-written metadata for the categories that earn impressions; the
   generated pattern remains the fallback for the rest. */
const seo = SEO_OVERRIDES[category.url];
const title =
  seo?.title ||
  `${category.name} | Custom Wholesale ${category.name.includes('Boxes') ? 'Packaging' : 'Boxes'}`;
const description = seo?.description || category.metaDescription;

/* Written content for this category. Every category imported with an empty
   description, so the page fell back to one generated sentence and all
   seventeen read alike. */
const content = CATEGORY_CONTENT[category.slug];

const pageSchema = [
  ...schema.categoryNode(category),
  schema.breadcrumbs(category.url, crumbs),
  ...(content?.faqs?.length ? [schema.faqPage(category.url, content.faqs)] : []),
];
---

<BaseLayout
  title={title}
  description={description}
  path={category.url}
  pageType="category"
  itemName={category.name}
  schema={pageSchema}
>
  <Breadcrumbs crumbs={crumbs} />

  <div class="wrap cat">
    <h1>{category.name}</h1>
    {content ? (
      <div class="cat__intro prose">{content.intro.map((p) => <p>{p}</p>)}</div>
    ) : category.description ? (
      <div class="prose cat__intro" set:html={category.description} />
    ) : (
      <p class="cat__intro">
        {items.length} custom {category.name.toLowerCase()} made to your dimensions,
        with free design assistance and an 8-10 business day turnaround.
      </p>
    )}

    {category.children.length > 0 && (
      <nav class="cat__children" aria-label="Subcategories">
        <h2>Browse by type</h2>
        <ul role="list">
          {category.children.map((c) => <li><a href={c.url} class="btn btn--ghost">{c.name}</a></li>)}
        </ul>
      </nav>
    )}
  </div>

  <section class="section" aria-labelledby="cat-products">
    <div class="wrap">
      <h2 id="cat-products" class="visually-hidden">
        {items.length} products in {category.name}
      </h2>
      <ProductGrid products={items} />
    </div>
  </section>

  {content && (
    <section class="section section--alt" aria-labelledby="cat-guide">
      <div class="wrap cat__guide">
        <h2 id="cat-guide" class="visually-hidden">
          Choosing {category.name.toLowerCase()}
        </h2>
        {content.sections.map((s) => (
          <div class="cat__block prose">
            <h2>{s.h2}</h2>
            {s.body.map((p) => <p>{p}</p>)}
            {s.list && <ul>{s.list.map((li) => <li>{li}</li>)}</ul>}
            {s.table && (
              <div class="table-scroll">
                <table>
                  <caption>{s.table.caption}</caption>
                  <thead>
                    <tr>{s.table.head.map((h) => <th scope="col">{h}</th>)}</tr>
                  </thead>
                  <tbody>
                    {s.table.rows.map((r) => (
                      <tr>
                        {r.map((cell, i) =>
                          i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>,
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        ))}
        {/* One contextual link out of the page, in its own paragraph so the
            one-link-per-paragraph rule holds structurally. */}
        {content.link && (
          <p class="cat__link prose">
            {content.link.lead}
            <a href={content.link.href}>{content.link.anchor}</a>
            {content.link.tail}
          </p>
        )}
      </div>
    </section>
  )}

  {content?.faqs?.length > 0 && (
    <section class="section" aria-labelledby="cat-faq">
      <div class="wrap cat__faq">
        <h2 id="cat-faq">{category.name} questions</h2>
        <FaqAccordion faqs={content.faqs} />
      </div>
    </section>
  )}

  <QuoteBand
    heading={`Need a quote for ${category.name.toLowerCase()}?`}
    body="Send your dimensions, quantity and artwork and we will price it for you."
  />
</BaseLayout>

<style>
  .cat { padding-block: clamp(1.5rem, 1.2rem + 1.4vw, 2.5rem) 0; }
  .cat h1 { margin-bottom: 0.4em; }
  .cat__intro { color: var(--ink-soft); max-width: 72ch; }

  .cat__children { margin-top: 1.5rem; }
  .cat__children h2 { font-size: var(--step-1); }
  .cat__children ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cat__children li { margin: 0; }
</style>
