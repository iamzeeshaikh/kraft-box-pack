---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FeatureStrip from '../components/home/FeatureStrip.astro';
import Industries from '../components/home/Industries.astro';
import Customization from '../components/home/Customization.astro';
import Process from '../components/home/Process.astro';
import FaqAccordion from '../components/product/FaqAccordion.astro';
import QuoteBand from '../components/QuoteBand.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { HOME_FAQS } from '../data/home-content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { products, popular, pages } from '../data/content';
import * as schema from '../lib/schema';

import brownKraft from '../assets/site/brown-kraft-packaging.jpg';
import paperGift from '../assets/site/custom-kraft-paper-gift.jpg';
import paperPackaging from '../assets/site/kraft-paper-packaging.jpg';
import miniBoxes from '../assets/site/custom-mini-kraft-boxes.jpg';
import blackKraft from '../assets/site/custom-black-kraft-packaging.jpg';
import candyBoxes from '../assets/site/custom-kraft-candy-boxes.jpg';
import { SEO_OVERRIDES } from '../data/seo-overrides';

const home = pages.find((p) => p.slug === 'home');

/**
 * The six hero photographs, in the order the supplied design shows them.
 * These are the originals from the old homepage, not stand-ins picked from
 * the catalogue.
 */
const collage: { image: ImageMetadata; alt: string }[] = [
  { image: brownKraft, alt: 'Brown kraft food packaging box' },
  { image: paperGift, alt: 'Custom kraft paper gift box tied with ribbon' },
  { image: paperPackaging, alt: 'Stacked kraft paper food containers' },
  { image: miniBoxes, alt: 'Custom mini kraft boxes' },
  { image: blackKraft, alt: 'Custom black kraft packaging box' },
  { image: candyBoxes, alt: 'Custom kraft candy boxes' },
];

/* The home page carries 33,242 impressions at 0.55% CTR from position 28.4 —
   the weakest CTR of any high-impression page on the site. The old description
   led with an environmental slogan and named no product, no size capability
   and no reason to click. See src/data/seo-overrides.ts. */
const seo = SEO_OVERRIDES['/'];
const title = seo.title;
const description = seo.description;

/**
 * The old home page listed all 158 products. It now shows the twenty most
 * viewed, at the owner's request, with a link through to the full catalogue.
 *
 * Every product still has its own page and is still linked from `/products/`
 * and from its category, so nothing becomes unreachable — but the 138 products
 * no longer linked from the home page do lose one inbound internal link each.
 * That trade is recorded in INTERNAL_LINK_PRESERVATION_REPORT.md.
 */
const featured = popular(20);
const pageSchema = [
  schema.webPage('/', title, description),
  /* The FAQ block below is visible on the page, so the schema matches it exactly. */
  schema.faqPage('/', HOME_FAQS),
  ...schema.collectionPage(
    '/',
    'Most requested custom kraft boxes',
    description,
    featured.map((p) => ({ name: p.name, url: p.url })),
  ),
];
---

<BaseLayout title={title} description={description} path="/" schema={pageSchema}>
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__form">
        <QuoteForm id="hero-quote" hero heading="Get A Quick Quote" />
      </div>

      <div class="hero__body">
        {/* The old heading led on "Eco-Friendly … for Every Packaging Need"
            with a lead that ended mid-sentence — "A Step Towards
            Sustainability. packaging needs." Neither said what the company
            sells or to whom, on the page carrying 33,242 impressions at a
            0.55% click-through rate. */}
        <h1>Custom Printed Kraft Boxes, Built to Your Size</h1>
        <p class="hero__lead">
          Wholesale packaging for US brands, cut on a fresh dieline rather than
          picked from stock sizes. Free design assistance, 100-unit minimum, and
          a written quote within one business day.
        </p>

        <ul class="hero__collage" role="list">
          {
            collage.map((c, i) => (
              <li>
                <Image
                  src={c.image}
                  alt={c.alt}
                  widths={[320, 560]}
                  sizes="(min-width: 900px) 300px, 45vw"
                  loading={i < 3 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  decoding="async"
                />
              </li>
            ))
          }
        </ul>

        <p class="hero__actions">
          <a href="/get-a-quote/" class="btn btn--primary">Get A Free Quote</a>
        </p>
      </div>
    </div>
  </section>

  <FeatureStrip />

  <section class="section" aria-labelledby="all-heading">
    <div class="wrap">
      <div class="section__head" data-reveal>
        <h2 id="all-heading">Browse Our High-Quality Custom Kraft Boxes</h2>
        <p>
          Our twenty most-requested styles. All {products.length} are made to your
          own dimensions and artwork.
        </p>
      </div>
      <ProductGrid products={featured} />
      <p class="all-link">
        <a href="/products/" class="btn btn--kraft">View all {products.length} kraft boxes</a>
      </p>
    </div>
  </section>

  <Industries />

  <Customization />

  <Process />

  {
    home?.html && (
      <section class="section section--alt" aria-labelledby="about-heading">
        <div class="wrap">
          <h2 id="about-heading" class="visually-hidden">About our kraft packaging</h2>
          <div class="prose home-prose" set:html={home.html} />
        </div>
      </section>
    )
  }

  <section class="section home-faq" aria-labelledby="home-faq-heading">
    <div class="wrap">
      <div class="section__head" data-reveal>
        <h2 id="home-faq-heading">Questions buyers ask first</h2>
        <p>Minimums, pricing, turnaround and artwork, answered before you enquire.</p>
      </div>
      <FaqAccordion faqs={HOME_FAQS} />
    </div>
  </section>

  <QuoteBand
    heading="Tell us what you are packing"
    body="Send your dimensions, quantity and artwork. You get a board grade, a structure, a print method and a written price — usually within one business day."
  />
</BaseLayout>

<style>
  /* The hero band is solid kraft brown (#865f34, sampled from the supplied
     design) with white type, and the quote panel sits on it as a white card. */
  .hero {
    background: var(--kraft);
    padding-block: clamp(1.5rem, 1.2rem + 1.6vw, 2.5rem) clamp(2rem, 1.6rem + 2vw, 3.5rem);
  }

  .hero__inner {
    display: grid;
    gap: clamp(1.5rem, 1.2rem + 1.6vw, 2.5rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  /* On a phone the single column would put a six-field form above the H1, so a
     visitor is asked to fill something in before being told what the site
     sells. The heading and photographs come first; the desktop layout below
     restores the design's side-by-side order. */
  .hero__body {
    order: -1;
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(320px, 400px) 1fr;
    }

    .hero__body {
      order: 0;
    }
  }

  .hero__body {
    text-align: center;
  }

  .hero__body h1 {
    color: #fff;
    margin-bottom: 0.35em;
  }

  .hero__lead {
    font-size: var(--step-1);
    color: #fff;
    max-width: 62ch;
    margin-inline: auto;
  }

  .hero__collage {
    display: grid;
    /* Three across, as the design shows, collapsing to two on a phone. */
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.75rem, 0.5rem + 1.1vw, 2rem);
    list-style: none;
    margin: clamp(1.25rem, 1rem + 1vw, 2rem) 0 0;
    padding: 0;
  }

  @media (min-width: 700px) {
    .hero__collage {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .hero__collage li {
    margin: 0;
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    padding: clamp(0.5rem, 0.35rem + 0.6vw, 1rem);
  }

  .hero__collage :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 8px;
  }

  .hero__actions {
    display: flex;
    justify-content: center;
    margin: clamp(1.25rem, 1rem + 1vw, 2rem) 0 0;
  }

  .hero__actions .btn {
    padding-inline: 2rem;
  }

  .all-link {
    display: flex;
    justify-content: center;
    margin: clamp(1.5rem, 1.2rem + 1vw, 2.5rem) 0 0;
  }

  /* Single column, as the live site sets it. The page container is wide so the
     hero heading fits on one line, but running body copy the full width of that
     container gives a 200-character measure that is unreadable, so the prose
     keeps its own limit. */
  .home-prose {
    max-width: 78ch;
    margin-inline: auto;
  }
</style>
