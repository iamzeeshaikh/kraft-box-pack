---
import BaseLayout from '../layouts/BaseLayout.astro';
import { topCategories } from '../data/content';
---
<BaseLayout
  title="Page not found | Kraft Box Pack"
  description="That page could not be found. Browse our custom kraft packaging ranges instead."
  path="/404/"
  noindex
>
  <div class="wrap section notfound">
    <h1>That page could not be found</h1>
    <p>The page may have moved, or the address may be mistyped. These may help:</p>
    <ul role="list">
      <li><a href="/products/">All custom kraft boxes</a></li>
      {topCategories.map((c) => <li><a href={c.url}>{c.name}</a></li>)}
      <li><a href="/get-a-quote/">Get a quote</a></li>
      <li><a href="/contact-us/">Contact us</a></li>
    </ul>
  </div>
</BaseLayout>

<style>
  .notfound { max-width: 68ch; }
  .notfound ul { columns: 2; column-gap: 2rem; }
  @media (max-width: 560px) { .notfound ul { columns: 1; } }
</style>
