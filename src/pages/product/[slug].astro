---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import ProductGallery from '../../components/product/ProductGallery.astro';
import ProductTabs from '../../components/product/ProductTabs.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import TrustBadges from '../../components/product/TrustBadges.astro';

import { products, relatedTo } from '../../data/content';
import { resolveAll } from '../../lib/images';
import * as schema from '../../lib/schema';
import { FEATURES } from '../../data/site';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const related = relatedTo(product);

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Products', url: '/products/' },
  ...(product.primary ? [{ name: product.primary.name, url: product.primary.url }] : []),
  { name: product.name, url: product.url },
];

const imageUrls = resolveAll(product.images).map((i) => i.image.src);

const title = product.seoTitle || `${product.name} | Custom Wholesale Packaging`;
const description =
  product.seoDescription ||
  product.plainShort.slice(0, 155) ||
  `Custom ${product.name.toLowerCase()} at wholesale prices from Kraft Box Pack.`;

const pageSchema = [
  schema.product(product, imageUrls),
  schema.breadcrumbs(product.url, crumbs),
  ...(product.faqs.length ? [schema.faqPage(product.url, product.faqs)] : []),
];
---

<BaseLayout
  title={title}
  description={description}
  path={product.url}
  image={imageUrls[0]}
  schema={pageSchema}
>
  <Breadcrumbs crumbs={crumbs} />

  <div class="wrap product">
    <div class="product__secure"><TrustBadges variant="secure" /></div>

    <div class="product__intro">
      <h1>{product.name}</h1>
      {product.shortDescription && (
        <div class="product__short prose" set:html={product.shortDescription} />
      )}
      <QuoteForm id="product-quote" hero heading="Get A Quick Quote" product={product.name} />
    </div>

    <div class="product__media">
      <ProductGallery images={product.images} name={product.name} />
      <p class="product__cta">
        <a href="/get-a-quote/" class="btn btn--kraft">Get a Quote</a>
      </p>
      <TrustBadges />
    </div>

    <aside class="product__aside" aria-label="What is included">
      <ul role="list">
        {FEATURES.map((f) => (
          <li>
            <img src={`/art/${f.art}`} alt="" width="150" height="110" loading="lazy" decoding="async" />
            <span>{f.title}</span>
          </li>
        ))}
      </ul>
    </aside>
  </div>

  <div class="wrap product__detail" data-full-width>
    <h2 class="visually-hidden">Product details</h2>
    <ProductTabs product={product} />
  </div>

  {related.length > 0 && (
    <section class="section section--alt" aria-labelledby="related-heading">
      <div class="wrap">
        <div class="section__head">
          <h2 id="related-heading">Related kraft boxes</h2>
          <p>
            Other {product.primary?.name.toLowerCase() ?? 'kraft boxes'} customers
            look at alongside {product.name.toLowerCase()}.
          </p>
        </div>
        <ProductGrid products={related} />
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* The badge strip spans the grid and sits above it, right-aligned, as the
     design places it beside the product title. */
  .product__secure {
    grid-column: 1 / -1;
    display: flex;
    justify-content: flex-end;
    margin: 0;
  }

  .product {
    display: grid;
    gap: clamp(1.25rem, 1rem + 1.6vw, 2.5rem);
    padding-block: clamp(1.5rem, 1.2rem + 1.4vw, 2.5rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 760px) {
    .product { grid-template-columns: 1fr 1fr; }
    .product__aside { grid-column: 1 / -1; }
  }

  /* The supplied design puts the enquiry form on the left, the gallery in the
     middle and the four service graphics down the right-hand edge. */
  @media (min-width: 1080px) {
    .product { grid-template-columns: 1.1fr 1.2fr 0.5fr; }
    .product__aside { grid-column: auto; }
  }

  .product h1 { margin-bottom: 0.45em; }

  .product__short {
    color: var(--ink-soft);
    max-width: 60ch;
    margin-bottom: 1.25rem;
  }

  .product__cta {
    display: flex;
    justify-content: center;
    margin: 1.25rem 0 0;
  }

  .product__aside ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 130px), 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 1080px) {
    .product__aside ul { grid-template-columns: 1fr; }
  }

  .product__aside li {
    margin: 0;
    text-align: center;
    padding: 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .product__aside img {
    /* The delivery graphic is 1024x582; fixing the height would push it wider
       than this column and crop it, so the width leads and the height follows. */
    width: 100%;
    height: auto;
    max-height: 84px;
    margin: 0 auto 0.4rem;
    object-fit: contain;
  }

  .product__aside span {
    display: block;
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .product__detail {
    padding-bottom: clamp(2rem, 1.6rem + 1.8vw, 3.5rem);
  }
</style>
