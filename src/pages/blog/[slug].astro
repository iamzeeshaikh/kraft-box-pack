---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqAccordion from '../../components/product/FaqAccordion.astro';
import { BLOG_POSTS } from '../../lib/blog';
import { blogPosting, breadcrumbs, faqPage } from '../../lib/schema';

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = post;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: post.title, url: post.url },
];

const fmt = (d: string) =>
  new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
const published = fmt(post.date);
/* Only shown where the article has actually been revised. A "last updated"
   line on an unrevised post claims a freshness it has not earned. */
const updated = post.updated ? fmt(post.updated) : null;
/* Narrowed once here so the template does not have to guard it twice. */
const faqs = post.faqs ?? [];
---
<BaseLayout
  title={post.metaTitle}
  description={post.metaDescription}
  path={post.url}
  pageType="blog"
  itemName={post.title}
  image={post.image}
  schema={[
    blogPosting(post),
    breadcrumbs(post.url, crumbs),
    ...(post.faqs?.length ? [faqPage(post.url, post.faqs)] : []),
  ]}
>
  <Breadcrumbs crumbs={crumbs} />

  <article class="post-wrap">
    <p class="post-date">
      Published {published}
      {updated && <> · Reviewed {updated}</>}
    </p>
    <img
      class="post-hero"
      src={post.image}
      alt={post.imageAlt}
      width={post.imageWidth}
      height={post.imageHeight}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="post-body">
      <Content />
    </div>

    {faqs.length > 0 && (
      <section class="post-faq" aria-labelledby="post-faq-heading">
        <h2 id="post-faq-heading">Questions about this</h2>
        <FaqAccordion faqs={faqs} />
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .post-wrap { max-width: 840px; margin: 0 auto; padding: 28px 16px 56px; }
  .post-date { font-size: .82rem; color: #8a7563; margin: 0 0 14px; }
  .post-hero { width: 100%; height: auto; border-radius: 10px; }
  .post-body { margin-top: 26px; }
  .post-body :global(h1) { font-size: 1.85rem; line-height: 1.25; margin: 0 0 14px; }
  .post-body :global(h2) { font-size: 1.3rem; margin: 30px 0 10px; }
  .post-body :global(h3) { font-size: 1.08rem; margin: 22px 0 8px; }
  .post-body :global(p) { margin: 0 0 14px; line-height: 1.75; }
  .post-body :global(ul), .post-body :global(ol) { margin: 0 0 14px; padding-left: 22px; }
  .post-body :global(li) { margin-bottom: 6px; line-height: 1.65; }
  .post-body :global(a) { color: #8a5a2b; text-decoration: underline; }
  .post-body :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 18px; font-size: .92rem; }
  .post-body :global(th), .post-body :global(td) { padding: .6rem .7rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .post-body :global(thead th) { background: var(--surface-alt); font-weight: 600; }
  .post-faq { margin-top: 40px; }
  .post-faq h2 { font-size: 1.3rem; margin: 0 0 14px; }
</style>
