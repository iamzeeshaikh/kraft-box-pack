---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import * as schema from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  html?: string;
  noindex?: boolean;
}

const { title, description, path, heading, html, noindex = false } = Astro.props;
const crumbs = [{ name: 'Home', url: '/' }, { name: heading, url: path }];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  noindex={noindex}
  schema={[schema.webPage(path, title, description), schema.breadcrumbs(path, crumbs)]}
>
  <Breadcrumbs crumbs={crumbs} />
  <article class="section">
    <div class="wrap page">
      <h1>{heading}</h1>
      {html ? <div class="prose" set:html={html} /> : <div class="prose"><slot /></div>}
    </div>
  </article>
</BaseLayout>

<style>
  .page { max-width: 78ch; }
  .page h1 { margin-bottom: 0.6em; }
</style>
