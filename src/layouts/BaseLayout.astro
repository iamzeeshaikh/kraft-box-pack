---
import Seo from '../components/Seo.astro';
import JsonLd from '../components/JsonLd.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { organization, website, graph } from '../lib/schema';
import '../styles/global.css';

import WhatsAppButton from '../components/WhatsAppButton.astro';
import Motion from '../components/Motion.astro';
interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  canonical?: string;
  image?: string;
  /** Page-specific JSON-LD nodes, merged into the site-wide @graph. */
  schema?: unknown[];
}

const {
  title,
  description,
  path,
  noindex = false,
  canonical,
  image,
  schema = [],
} = Astro.props;

const document = graph([organization(), website(), ...schema]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="oT73USHYOzbrPO-KDq1tOt-4dynXFIeBpLQEu-o9Lgs" />
    {/* The kraft-bag mark from the logo artwork. A PNG set rather than an SVG
        because the logo is supplied as raster; .ico is kept so that browsers
        and crawlers requesting /favicon.ico by convention are answered. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1f7a2b" />
    <Seo
      title={title}
      description={description}
      path={path}
      noindex={noindex}
      canonical={canonical}
      image={image}
    />
    <JsonLd data={document} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
      <Motion />
    </main>
    <SiteFooter />

    {/* ZeeOps live chat, deferred to the first interaction (or 6s after load)
        so its 23KB and its site-config request never compete with the page's
        own LCP. See public/chat-loader.js. Conversations land in the dashboard
        at chat.zeeops.dev under the `kraftboxpack` site. */}
    <script src="/chat-loader.js" defer></script>
      <WhatsAppButton />
  </body>
</html>
