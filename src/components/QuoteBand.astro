---
import { CONTACT } from '../data/site';
interface Props { heading: string; body: string }
const { heading, body } = Astro.props;
---
<section class="band">
  <div class="wrap band__inner">
    <div>
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    <p class="band__actions">
      <a href="/get-a-quote/" class="btn btn--primary">Get a Quote</a>
      <a href={`tel:${CONTACT.phone}`} class="btn btn--ghost band__call">{CONTACT.phoneDisplay}</a>
    </p>
  </div>
</section>

<style>
  .band { background: var(--kraft-tint); border-top: 1px solid var(--line); }
  .band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding-block: clamp(1.75rem, 1.4rem + 1.4vw, 2.75rem);
  }
  .band h2 { font-size: var(--step-2); margin-bottom: 0.25em; }
  .band p { margin: 0; color: var(--ink-soft); max-width: 56ch; }
  .band__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .band__call { background: var(--surface); }
</style>
