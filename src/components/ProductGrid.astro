---
import ProductCard from './ProductCard.astro';
import type { Product } from '../data/content';

interface Props { products: Product[]; headingLevel?: 'h2' | 'h3' }
const { products, headingLevel = 'h3' } = Astro.props;
---
<ul class="grid" role="list" data-product-grid>
  {products.map((p, i) => (
    <li><ProductCard product={p} priority={i < 4} headingLevel={headingLevel} /></li>
  ))}
</ul>

<style>
  .grid {
    display: grid;
    gap: var(--gap);
    /* Four across on desktop, as the design shows, stepping down cleanly. */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .grid > li { margin: 0; display: flex; }
  /* `display: flex` above outranks the user-agent rule for [hidden], so the
     filter would set the attribute and nothing would disappear. */
  .grid > li[hidden] { display: none; }
  .grid > li > :global(*) { width: 100%; }
</style>
