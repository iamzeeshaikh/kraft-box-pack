---
import { Image } from 'astro:assets';
import { primary } from '../lib/images';
import type { Product } from '../data/content';

interface Props {
  product: Product;
  /** The first row of a grid is eager; everything below it is lazy. */
  priority?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { product, priority = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const hero = primary(product.images);
---
<article class="card">
  <a class="card__link" href={product.url}>
    <div class="card__media">
      {hero ? (
        <Image
          src={hero.image}
          alt={hero.alt}
          widths={[220, 420]}
          sizes="(min-width: 1100px) 260px, (min-width: 700px) 30vw, 45vw"
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding="async"
          class="card__img"
        />
      ) : (
        <div class="card__placeholder" aria-hidden="true">No image</div>
      )}
    </div>
    <Heading class="card__title">{product.name}</Heading>
  </a>
  <p class="card__cta">
    <span class="btn btn--dark btn--block">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"
        ><path d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM1 2h3.3l.9 4H22l-2.6 9H7.3L5.5 6M6.2 8l1.3 5h10.4l1.4-5z"
      /></svg>
      Get a Quote
    </span>
  </p>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: box-shadow 0.16s, transform 0.16s, border-color 0.16s;
  }
  .card:hover {
    box-shadow: var(--shadow-lg);
    border-color: var(--kraft-light);
    transform: translateY(-2px);
  }
  .card__link {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 0.75rem 0.75rem 0;
    color: inherit;
    text-decoration: none;
  }
  .card__media {
    aspect-ratio: 1;
    background: var(--surface-alt);
    border-radius: 6px;
    overflow: hidden;
  }
  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .card__title {
    font-size: var(--step-0);
    font-weight: 700;
    margin: 0.7rem 0 0.5rem;
    text-align: center;
    /* Keeps every card in a row the same height whatever the name length. */
    flex: 1;
  }
  .card:hover .card__title { color: var(--kraft-dark); }
  .card__cta { margin: 0; padding: 0 0.75rem 0.75rem; }
  /* A span, not a button: the whole card is already one link. */
  .card__cta .btn {
    pointer-events: none;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    min-height: 38px;
    border-radius: 0;
  }
</style>
