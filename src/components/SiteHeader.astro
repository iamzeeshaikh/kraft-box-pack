---
import { NAV, CONTACT, PROMO, SOCIAL } from '../data/site';
import categories from '../data/categories.json';
import products from '../data/products.json';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

/**
 * Each category link in the menu opens a dropdown of the products WordPress
 * filed under it, read from the same exports that build the category pages —
 * so the menu can never list a product the site does not have.
 */
const productBySlug = new Map(products.map((p) => [p.slug, { name: p.name, url: p.url }]));
const subFor = (href: string) => {
  const slug = href.match(/product-category\/([^/]+)/)?.[1];
  const cat = categories.find((c) => c.slug === slug);
  return (cat?.products ?? [])
    .map((s) => productBySlug.get(s))
    .filter((p): p is { name: string; url: string } => Boolean(p));
};
const navItems = NAV.map((item) => ({ ...item, sub: subFor(item.href) }));
---

<div class="utility">
  <div class="wrap utility__inner">
    <p class="utility__contact">
      <a href={`tel:${CONTACT.phone}`}><Icon name="phone" size={16} />{CONTACT.phoneDisplay}</a>
      <a href={`mailto:${CONTACT.email}`}><Icon name="mail" size={16} />{CONTACT.email}</a>
    </p>

    <p class="utility__promo"><a href={`mailto:${CONTACT.email}`}>{PROMO}</a></p>

    <ul class="utility__links" role="list">
      <li>
        <a href="/products/#find" class="utility__icon">
          <Icon name="search" size={17} /><span class="visually-hidden">Search products</span>
        </a>
      </li>
      {SOCIAL.map((sn) => (
        <li>
          <a
            href={sn.href}
            class:list={['utility__icon', `utility__icon--${sn.name.toLowerCase()}`]}
            rel="noopener noreferrer nofollow"
            target="_blank"
          >
            <Icon name={sn.name.toLowerCase()} size={17} />
            <span class="visually-hidden">{sn.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<header class="header">
  <div class="wrap header__inner">
    <Logo height={74} />

    <button
      type="button"
      class="burger"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-menu-toggle
    >
      <span class="burger__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="primary-nav" class="nav" aria-label="Primary" data-menu>
      <ul class="nav__list">
        {
          navItems.map((item, i) =>
            item.sub.length === 0 ? (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ) : (
              <li class="nav__item--sub">
                <span class="nav__row">
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                  <button
                    type="button"
                    class="nav__caret"
                    aria-expanded="false"
                    aria-controls={`nav-sub-${i}`}
                    data-sub-toggle
                  >
                    <Icon name="chevron" size={13} />
                    <span class="visually-hidden">Open {item.label} submenu</span>
                  </button>
                </span>
                <ul
                  class:list={['nav__sub', item.sub.length >= 10 && 'nav__sub--cols']}
                  id={`nav-sub-${i}`}
                >
                  <li class="nav__sub-all">
                    <a href={item.href}>View all {item.label}</a>
                  </li>
                  {item.sub.map((p) => (
                    <li>
                      <a href={p.url}>{p.name}</a>
                    </li>
                  ))}
                </ul>
              </li>
            ),
          )
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .utility {
    background: var(--green);
    color: #fff;
    font-size: var(--step--1);
  }

  .utility__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem 1.25rem;
    padding-block: 0.3rem;
  }

  /* The promo pill is centred in the bar on the live site, with the contact
     details to its left and the search and social icons to its right. */
  .utility__promo {
    margin-inline: auto;
  }

  .utility p {
    margin: 0;
  }

  .utility__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
  }

  .utility__contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #fff;
    text-decoration: none;
    /* 44px tall on touch, without stretching the bar on the desktop layout. */
    padding-block: 0.3rem;
  }

  .utility__contact a:hover {
    text-decoration: underline;
    color: #fff;
  }

  .utility__promo a {
    display: inline-block;
    background: var(--surface-dark);
    color: #fff;
    font-weight: 700;
    font-style: italic;
    padding: 0.35rem 1.4rem;
    border-radius: 999px;
    text-decoration: none;
  }

  .utility__promo a:hover {
    background: #000;
    color: #fff;
  }

  .utility__links {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .utility__links li {
    margin: 0;
  }

  .utility__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: #fff;
  }

  .utility__icon--facebook,
  .utility__icon--linkedin {
    background: #fff;
    color: var(--green);
  }

  .utility__icon:hover {
    color: #fff;
    background: rgb(0 0 0 / 25%);
  }

  .utility__icon--facebook:hover,
  .utility__icon--linkedin:hover {
    background: var(--surface-dark);
    color: #fff;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.5rem;
  }

  .burger {
    display: none;
    align-items: center;
    justify-content: center;
    /* Full 44px target: the old site collapsed this to a 16px tap area. */
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    cursor: pointer;
  }

  .burger__bars {
    display: grid;
    gap: 4px;
  }

  .burger__bars span {
    display: block;
    width: 20px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
  }

  .nav__list {
    display: flex;
    align-items: center;
    /* One row: the live menu never wraps, so it must not wrap here either. */
    flex-wrap: nowrap;
    gap: 0.25rem clamp(0.9rem, 0.2rem + 1.2vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__list li {
    margin: 0;
  }

  .nav__list a:not(.btn) {
    display: block;
    padding: 0.55rem 0.15rem;
    color: var(--ink);
    text-decoration: none;
    /* The design sets the menu in the same serif as the wordmark. */
    font-family: var(--font-display);
    font-size: clamp(0.86rem, 0.62rem + 0.42vw, 1.05rem);
    font-weight: 700;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }

  .nav__list a:not(.btn):hover,
  .nav__list a[aria-current='page'] {
    color: var(--kraft-dark);
    border-bottom-color: var(--kraft);
  }

  /* --- dropdown menus ---------------------------------------------------- */
  .nav__item--sub {
    position: relative;
  }

  .nav__row {
    display: inline-flex;
    align-items: center;
    gap: 0.05rem;
  }

  .nav__caret {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .nav__caret:hover {
    color: var(--kraft-dark);
    background: var(--kraft-tint);
  }

  .nav__caret :global(svg) {
    transform: rotate(90deg);
    transition: transform 0.15s;
  }

  .nav__item--sub:hover .nav__caret :global(svg),
  .nav__item--sub:focus-within .nav__caret :global(svg),
  .nav__item--sub[data-open='true'] .nav__caret :global(svg) {
    transform: rotate(270deg);
  }

  .nav__sub {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 50;
    min-width: 250px;
    margin: 0;
    padding: 0.45rem;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity 0.15s, transform 0.15s, visibility 0.15s;
  }

  .nav__item--sub:hover .nav__sub,
  .nav__item--sub:focus-within .nav__sub,
  .nav__item--sub[data-open='true'] .nav__sub {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* The widest panels sit under the right end of the bar; opening them to the
     left keeps them inside the viewport. */
  .nav__list > li:nth-last-child(-n + 2) .nav__sub {
    left: auto;
    right: 0;
  }

  .nav__sub--cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(200px, 1fr));
    column-gap: 0.35rem;
  }

  .nav__sub li {
    margin: 0;
  }

  /* Dropdown entries read as a list, not as more menu bar: body face, no
     underline rule, a soft hover fill instead. */
  .nav__list .nav__sub a:not(.btn) {
    display: block;
    padding: 0.5rem 0.75rem;
    border-bottom: 0;
    border-radius: 8px;
    font-family: var(--font);
    font-size: 0.92rem;
    font-weight: 500;
  }

  .nav__list .nav__sub a:not(.btn):hover,
  .nav__list .nav__sub a[aria-current='page'] {
    background: var(--kraft-tint);
    color: var(--kraft-dark);
  }

  .nav__sub-all {
    grid-column: 1 / -1;
    border-bottom: 1px solid var(--line);
    margin-bottom: 0.3rem;
    padding-bottom: 0.3rem;
  }

  .nav__list .nav__sub-all a:not(.btn) {
    font-weight: 700;
    color: var(--kraft-dark);
  }

  @media (max-width: 1040px) {
    .burger {
      display: inline-flex;
    }

    .nav {
      position: absolute;
      inset: 100% 0 auto;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-lg);
      padding: 0.5rem 1rem 1rem;
      /* The old site left the closed menu sitting over the header, swallowing
         clicks on the logo. Hidden means hidden, on both axes. */
      visibility: hidden;
      pointer-events: none;
      opacity: 0;
      transform: translateY(-6px);
      transition: opacity 0.15s, transform 0.15s, visibility 0.15s;
    }

    .nav[data-open='true'] {
      visibility: visible;
      pointer-events: auto;
      opacity: 1;
      transform: none;
    }

    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav__list li + li {
      border-top: 1px solid var(--line);
    }

    .nav__list a:not(.btn) {
      padding: 0.85rem 0.25rem;
    }

    /* On the phone the dropdown becomes an accordion: the caret button gets a
       full-size target and the sub list folds out in place, indented. */
    .nav__row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .nav__row a {
      flex: 1;
    }

    .nav__caret {
      width: 44px;
      height: 44px;
    }

    .nav__sub {
      display: none;
      position: static;
      min-width: 0;
      padding: 0 0 0.6rem 0.85rem;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none;
      transition: none;
    }

    .nav__item--sub[data-open='true'] .nav__sub {
      display: block;
    }

    .nav__sub--cols {
      display: none;
      grid-template-columns: 1fr;
    }

    .nav__item--sub[data-open='true'] .nav__sub--cols {
      display: block;
    }

    .nav__sub li + li {
      border-top: 0;
    }

    .nav__sub-all {
      border-bottom: 1px solid var(--line);
    }
  }
</style>

<script>
  import { wireMenu } from '../scripts/menu';
  wireMenu();
</script>
