---
/**
 * The quote request form.
 *
 * One component covers every placement: the hero panel, the product sidebar,
 * the contact page and the dark band above the footer. `compact` switches to
 * the two-column dark styling the old footer used; `product` pre-fills and
 * locks the product field so the enquiry arrives attributed.
 */
interface Props {
  id: string;
  compact?: boolean;
  /** The homepage/product-page styling: green pill heading, placeholder-only
      fields and the payment badges, exactly as the supplied design shows. */
  hero?: boolean;
  product?: string;
  heading?: string;
  intro?: string;
}

const { id, compact = false, hero = false, product, heading, intro } = Astro.props;
const field = (name: string) => `${id}-${name}`;

/**
 * Small glyphs sitting inside each field. Decorative — every input still has a
 * real label — but they give the column a rhythm instead of five identical
 * pills, and they make the form scannable before it is read.
 */
const ICONS: Record<string, string> = {
  name: 'M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2c-5 0-9 2.7-9 6v2h18v-2c0-3.3-4-6-9-6z',
  email: 'M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 2v.5l8 4.5 8-4.5V6H4zm16 2.8-7.5 4.2a1 1 0 0 1-1 0L4 8.8V18h16z',
  phone: 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .58 3.6 1 1 0 0 1-.25 1z',
  product: 'M12 2 3 6.5v11L12 22l9-4.5v-11zm0 2.2 6.5 3.3L12 10.8 5.5 7.5zM5 9.2l6 3v7.3l-6-3zm8 10.3v-7.3l6-3v7.3z',
  message: 'M4 3h16a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2zm0 2v12.1L7.2 16H20V5z',
};
---

<form
  class:list={['qf', compact && 'qf--compact', hero && 'qf--hero']}
  id={id}
  method="post"
  action="/api/quote/"
  enctype="multipart/form-data"
  novalidate
  data-quote-form
>
  {heading && <h2 class="qf__heading">{heading}</h2>}
  {intro && !hero && <p class="qf__intro">{intro}</p>}

  <div class="qf__grid">
    <div class="qf__field">
      <label for={field('name')} class:list={[hero && 'visually-hidden']}>
        Name <span aria-hidden="true">*</span>
      </label>
      <span class="qf__wrap">
      {hero && <svg class="qf__icon" viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d={ICONS.name} /></svg>}
      <input
        type="text"
        id={field('name')}
        name="name"
        autocomplete="name"
        required
        maxlength="120"
        placeholder={hero ? 'Name' : undefined}
      />
      </span>
    </div>

    <div class="qf__field">
      <label for={field('email')} class:list={[hero && 'visually-hidden']}>
        Email <span aria-hidden="true">*</span>
      </label>
      <span class="qf__wrap">
      {hero && <svg class="qf__icon" viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d={ICONS.email} /></svg>}
      <input
        type="email"
        id={field('email')}
        name="email"
        autocomplete="email"
        required
        maxlength="180"
        placeholder={hero ? 'Email' : undefined}
      />
      </span>
    </div>

    <div class="qf__field">
      <label for={field('phone')} class:list={[hero && 'visually-hidden']}>Phone</label>
      <span class="qf__wrap">
      {hero && <svg class="qf__icon" viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d={ICONS.phone} /></svg>}
      <input
        type="tel"
        id={field('phone')}
        name="phone"
        autocomplete="tel"
        maxlength="40"
        placeholder={hero ? 'Phone' : undefined}
      />
      </span>
    </div>

    {/* The live hero form is Name, Email, Phone, Product, Message. Company is
        offered only on the fuller forms, where there is room for it. */}
    {!hero && (
      <div class="qf__field">
        <label for={field('company')}>Company</label>
        <input
          type="text"
          id={field('company')}
          name="company"
          autocomplete="organization"
          maxlength="120"
        />
      </div>
    )}

    <div class="qf__field qf__field--wide">
      <label for={field('product')} class:list={[hero && 'visually-hidden']}>Product</label>
      <span class="qf__wrap">
      {hero && <svg class="qf__icon" viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d={ICONS.product} /></svg>}
      <input
        type="text"
        id={field('product')}
        name="product"
        value={product}
        readonly={product ? true : undefined}
        maxlength="160"
        placeholder={hero ? 'Product' : undefined}
      />
      </span>
    </div>

    <div class="qf__field qf__field--wide">
      <label for={field('message')} class:list={[hero && 'visually-hidden']}>
        Your packaging requirements <span aria-hidden="true">*</span>
      </label>
      <span class="qf__wrap qf__wrap--area">
      {hero && <svg class="qf__icon" viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d={ICONS.message} /></svg>}
      <textarea
        id={field('message')}
        name="message"
        rows={compact ? 3 : hero ? 5 : 4}
        required
        maxlength="4000"
        placeholder={hero ? 'Message' : undefined}
      ></textarea>
      </span>
    </div>

    <div class:list={['qf__field', 'qf__field--wide', hero && 'qf__file']}>
      <label for={field('file')} class:list={[hero && 'visually-hidden']}>
        Artwork or reference file
        <span class="qf__hint">(optional, JPG PNG PDF AI EPS ZIP, max 8&nbsp;MB)</span>
      </label>
      <input
        type="file"
        id={field('file')}
        name="attachment"
        accept=".jpg,.jpeg,.png,.pdf,.ai,.eps,.zip,image/jpeg,image/png,application/pdf,application/zip"
      />
    </div>
  </div>

  {/* Bots fill every field they can see; people never see this one. */}
  <div class="qf__trap" aria-hidden="true">
    <label for={field('website')}>Leave this field empty</label>
    <input type="text" id={field('website')} name="website" tabindex="-1" autocomplete="off" />
  </div>

  <button
    type="submit"
    class:list={['btn', compact ? 'btn--primary' : 'btn--kraft', !hero && 'btn--block']}
  >
    Submit
  </button>

  {hero && (
    <p class="qf__promise">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"
        ><path d="M9.6 16.2 4.8 11.4l-1.4 1.4 6.2 6.2L21 7.6l-1.4-1.4z" /></svg>
      Reply within one business day &middot; Free design &middot; No obligation
    </p>
  )}

  <p class="qf__status" role="status" aria-live="polite" data-quote-status></p>

  {hero && (
    <img
      class="qf__payments"
      src="/art/payment-image.jpeg"
      alt="PayPal, SSL secure connection, Visa and Mastercard accepted"
      width="331"
      height="152"
      loading="lazy"
      decoding="async"
    />
  )}
</form>

<style>
  .qf {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1rem, 0.85rem + 0.7vw, 1.5rem);
    box-shadow: var(--shadow);
  }

  .qf__heading {
    font-size: var(--step-2);
    margin-bottom: 0.35em;
  }

  .qf__intro {
    color: var(--muted);
    font-size: var(--step--1);
    margin-bottom: 1rem;
  }

  .qf__grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
  }

  .qf__field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .qf__field--wide {
    grid-column: 1 / -1;
  }

  .qf label {
    font-size: var(--step--1);
    font-weight: 600;
  }

  .qf label span[aria-hidden] {
    color: var(--danger);
  }

  .qf__hint {
    font-weight: 400;
    color: var(--muted);
  }

  .qf :is(input, textarea) {
    width: 100%;
    min-height: 44px;
    padding: 0.55rem 0.7rem;
    font: inherit;
    font-size: var(--step-0);
    color: var(--ink);
    background: var(--surface);
    border: 1px solid #c8c5c0;
    border-radius: var(--radius);
  }

  .qf textarea {
    resize: vertical;
  }

  .qf :is(input, textarea):focus-visible {
    border-color: var(--green);
    box-shadow: 0 0 0 3px var(--green-tint);
    outline: none;
  }

  .qf input[readonly] {
    background: var(--surface-alt);
    color: var(--ink-soft);
  }

  .qf input[type='file'] {
    padding: 0.45rem;
    font-size: var(--step--1);
  }

  .qf [aria-invalid='true'] {
    border-color: var(--danger);
  }

  .qf__error {
    color: var(--danger);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .qf button {
    margin-top: 1rem;
  }

  .qf__trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .qf__status {
    margin: 0.85rem 0 0;
    font-size: var(--step--1);
    font-weight: 600;
    min-height: 1.2em;
  }

  .qf__status[data-state='ok'] {
    color: var(--green-dark);
  }

  .qf__status[data-state='error'] {
    color: var(--danger);
  }

  /* --- hero variant, matching the supplied design ------------------------ */
  .qf--hero {
    border-radius: 20px;
    padding: 0 0 1.4rem;
    overflow: hidden;
    border-color: #e6e1da;
    background-color: #fff;
    background-image: linear-gradient(180deg, #fff 0%, #fdfbf8 100%);
    box-shadow: 0 2px 4px rgb(35 35 35 / 5%), 0 14px 36px rgb(134 95 52 / 12%);
  }

  /* The green pill heading sits flush across the top of the panel. */
  .qf--hero .qf__heading {
    /* The colour is stated as well as the gradient: it is the fallback, and it
       is what a contrast checker can actually measure. */
    background-color: var(--green);
    background-image: linear-gradient(135deg, var(--green) 0%, #2aa32c 100%);
    color: #fff;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    text-align: center;
    margin: 0 0 1.25rem;
    padding: 0.9rem 1rem;
    border-radius: 20px 20px 28px 28px;
    box-shadow: 0 4px 14px rgb(33 136 35 / 25%);
  }

  .qf--hero .qf__grid {
    grid-template-columns: 1fr;
    gap: 0.65rem;
    padding-inline: 1.15rem;
  }

  /* The glyph is positioned over the field, so the control keeps room for it
     rather than the text running underneath — the mistake that made the icons
     unreadable on the previous migration. */
  .qf__wrap {
    position: relative;
    display: block;
  }

  .qf__icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--kraft-light);
    pointer-events: none;
    transition: color 0.15s;
  }

  .qf__wrap--area .qf__icon {
    top: 1rem;
    transform: none;
  }

  .qf--hero .qf__wrap :is(input, textarea) {
    padding-left: 2.7rem;
  }

  .qf__wrap:focus-within .qf__icon {
    color: var(--green);
  }

  .qf__promise {
    /* Not flex: on a narrow column the text wraps to a second line and a flex
       icon is left stranded beside the block. Inline keeps it with the words. */
    display: block;
    text-align: center;
    margin: 0.9rem 1.15rem 0;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--muted);
    text-align: center;
    line-height: 1.35;
  }

  .qf__promise svg {
    display: inline;
    vertical-align: -2px;
    margin-right: 0.3rem;
    color: var(--green);
  }

  .qf--hero :is(input, textarea) {
    border-radius: 999px;
    border-color: #ddd8d1;
    background: #fcfbfa;
    padding-inline: 1.2rem;
    transition: border-color 0.15s, background-color 0.15s, box-shadow 0.15s;
  }

  .qf--hero :is(input, textarea)::placeholder {
    color: #8c877f;
  }

  .qf--hero :is(input, textarea):hover {
    border-color: #c6bfb6;
  }

  .qf--hero :is(input, textarea):focus-visible {
    background: #fff;
    border-color: var(--green);
    box-shadow: 0 0 0 3px var(--green-tint);
  }

  .qf--hero textarea {
    border-radius: 22px;
    padding-block: 0.8rem;
    min-height: 130px;
  }

  /* The default file control is a browser widget that ignores most styling;
     the label is turned into the button and the real input is kept
     screen-reader reachable but out of the way. */
  .qf--hero .qf__file {
    align-items: center;
    gap: 0.5rem;
    padding: 0.15rem 0.2rem 0;
  }

  .qf--hero input[type='file'] {
    border: 0;
    background: none;
    padding: 0;
    border-radius: 0;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .qf--hero input[type='file']::file-selector-button {
    margin-right: 0.6rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid #ddd8d1;
    border-radius: 999px;
    background: #f4f1ec;
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
  }

  .qf--hero input[type='file']::file-selector-button:hover {
    background: var(--kraft-tint);
    border-color: var(--kraft-light);
  }

  .qf--hero button {
    display: block;
    width: calc(100% - 2.3rem);
    margin: 1.25rem auto 0;
    border-radius: 999px;
    font-size: 1.02rem;
    letter-spacing: 0.01em;
    background-color: var(--kraft);
    background-image: linear-gradient(135deg, var(--kraft) 0%, #9a6f40 100%);
    box-shadow: 0 4px 14px rgb(134 95 52 / 32%);
  }

  .qf--hero button:hover {
    background-color: var(--kraft-dark);
    background-image: linear-gradient(135deg, var(--kraft-dark) 0%, var(--kraft) 100%);
  }

  .qf--hero .qf__status {
    padding-inline: 1.15rem;
    text-align: center;
  }

  .qf__payments {
    display: block;
    width: min(100%, 240px);
    height: auto;
    margin: 1.35rem auto 0;
  }

  /* --- dark variant, as used above the footer ---------------------------- */
  .qf--compact {
    background: transparent;
    border: 0;
    box-shadow: none;
    padding: 0;
  }

  .qf--compact label {
    color: #eae7e2;
  }

  /* The dark red used on white is only 2.08:1 against the dark panel. */
  .qf--compact label span[aria-hidden] {
    color: #ff9b93;
  }

  .qf--compact .qf__hint {
    color: #b9b5af;
  }

  .qf--compact :is(input, textarea) {
    background: #3a3a3a;
    border-color: #4e4e4e;
    color: #fff;
  }

  .qf--compact :is(input, textarea)::placeholder {
    color: #b0aca6;
  }

  .qf--compact input[readonly] {
    background: #333;
    color: #d4d0cb;
  }

  .qf--compact .qf__status[data-state='ok'] {
    color: #8fdc97;
  }

  .qf--compact .qf__status[data-state='error'] {
    color: #ff9b93;
  }
</style>

<script>
  import { wireQuoteForms } from '../scripts/quote-form';
  wireQuoteForms();
</script>
