---
import { CONTACT, SOCIAL, FOOTER_COMPANY, NAV, COPYRIGHT } from '../data/site';
import Icon from './Icon.astro';
import QuoteForm from './QuoteForm.astro';

const categoryLinks = NAV.filter((n) => n.href !== '/');
---

<section class="contact-band" id="contact">
  <div class="wrap contact-band__inner">
    <div class="contact-band__form">
      <h2 class="visually-hidden">Request a quote</h2>
      <QuoteForm id="footer-quote" compact />
    </div>

    <div class="contact-band__aside">
      <h2>Let's work together</h2>
      <p>Get in touch today and receive a complimentary consultation.</p>

      <p class="contact-band__item">
        <span class="contact-band__label">Email</span>
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      </p>
      <p class="contact-band__item">
        <span class="contact-band__label">Phone</span>
        <a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneDisplay}</a>
      </p>

      <ul class="socials">
        {
          SOCIAL.map((s) => (
            <li>
              <a href={s.href} rel="noopener noreferrer nofollow" target="_blank">
                <Icon name={s.name.toLowerCase()} size={18} />
                <span class="visually-hidden">{s.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap footer__grid">
    <div>
      <h2 class="visually-hidden">Contact</h2>
      <ul class="footer__contact">
        <li>
          <strong>Email:</strong>
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </li>
        <li>
          <strong>Phone:</strong>
          <a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneDisplay}</a>
        </li>
        <li>
          <strong>Address:</strong>
          <address>{CONTACT.address.display}</address>
        </li>
      </ul>

      <ul class="footer__social" role="list">
        {
          SOCIAL.map((sn) => (
            <li>
              <a href={sn.href} rel="noopener noreferrer nofollow" target="_blank">
                <Icon name={sn.name.toLowerCase()} size={18} />
                <span class="visually-hidden">{sn.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav aria-labelledby="footer-company">
      <h2 class="footer__heading" id="footer-company">Company</h2>
      <ul class="footer__links">
        {FOOTER_COMPANY.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav aria-labelledby="footer-categories">
      <h2 class="footer__heading" id="footer-categories">Box Categories</h2>
      <ul class="footer__links">
        {categoryLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>

</footer>

<div class="footer__base">
  <div class="wrap footer__base-inner">
    <p>{COPYRIGHT}</p>
    <img
      src="/art/certificate.png"
      alt="DMCA protected, SiteLock secured, Comodo Secure, Trust Guard verified and BBB accredited business"
      width="564"
      height="72"
      loading="lazy"
      decoding="async"
    />
  </div>
</div>

<style>
  .contact-band {
    background: var(--surface-dark);
    color: #fff;
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.25rem);
  }

  .contact-band__inner {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .contact-band__inner {
      grid-template-columns: 1.15fr 1fr;
      align-items: start;
    }
  }

  .contact-band__aside h2 {
    color: #fff;
    font-family: var(--font-display);
    font-size: var(--step-3);
    margin-bottom: 0.4em;
  }

  .contact-band__aside > p {
    color: #d8d6d2;
    max-width: 40ch;
  }

  .contact-band__item {
    margin-bottom: 0.75rem;
  }

  .contact-band__label {
    display: block;
    font-weight: 700;
    font-size: var(--step-1);
    color: #fff;
  }

  .contact-band__item a {
    color: #ded9d2;
  }

  .contact-band__item a:hover {
    color: #fff;
  }

  .socials {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .socials li {
    margin: 0;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgb(255 255 255 / 10%);
    color: #fff;
  }

  .socials a:hover {
    background: var(--kraft);
    color: #fff;
  }

  .footer {
    background: var(--kraft);
    color: #fff;
    padding-block: clamp(2rem, 1.6rem + 1.6vw, 3rem);
  }

  .footer__grid {
    display: grid;
    gap: 1.75rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
  }

  .footer__heading {
    font-size: var(--step--1);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 0.9em;
  }

  .footer a {
    color: #fbf6f0;
    text-decoration: none;
  }

  .footer a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .footer__contact,
  .footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
  }

  .footer__contact li {
    display: block;
  }

  .footer__contact strong {
    display: block;
  }

  .footer__contact address {
    font-style: normal;
  }

  .footer__social {
    display: flex;
    gap: 0.6rem;
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
  }

  .footer__social li {
    margin: 0;
  }

  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: #fff;
  }

  .footer__social a:hover {
    color: var(--kraft-tint);
  }

  .footer__contact li + li,
  .footer__links li + li {
    margin-top: 0.55rem;
  }

  .footer__links a {
    display: inline-block;
    padding-block: 0.15rem;
  }

  /* The live site closes with a white strip below the kraft band: the
     copyright on the left and the certification badges on the right. */
  .footer__base {
    background: var(--surface);
    font-size: var(--step--1);
  }

  .footer__base-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1rem;
  }

  .footer__base p {
    margin: 0;
    font-weight: 700;
    color: var(--ink);
  }

  .footer__base img {
    width: auto;
    height: auto;
    max-width: min(100%, 420px);
  }
</style>
