---
/**
 * Analytics, gated on configuration.
 *
 * No measurement ID exists for this property yet, and inventing one would
 * silently send nothing while looking wired up. So nothing loads unless
 * `PUBLIC_GA4_ID` is set — set it and the tag, the page-type events and the
 * interaction tracking below all start working with no other change.
 *
 * The event layer itself is NOT gated. `dataLayer` is always created and every
 * event is always pushed to it, so a tag manager added later receives the full
 * history of interactions without anything being re-instrumented. That also
 * means the events can be verified in the console today, before any account
 * exists.
 *
 * Nothing here sends a form field value. The events carry page type, product
 * or category name, and the element that was clicked — never a name, an email,
 * a phone number or anything typed into the quote form.
 */
interface Props {
  /** 'home' | 'product' | 'category' | 'blog' | 'other' */
  pageType?: string
  /** Product or category name, where the page has one. */
  itemName?: string
}

const { pageType = 'other', itemName } = Astro.props
const GA4_ID = import.meta.env.PUBLIC_GA4_ID ?? 'G-FE7XZT3HT0'
---

{/*
  The per-page values travel through the DOM rather than through `define:vars`.
  `define:vars` forces `is:inline`, and Astro emits no CSP hash for an inline
  script — so under this site's strict `script-src` the whole event layer was
  blocked on every page, silently, while looking correct in the source. A
  bundled script is served from `/_astro/` and satisfies `'self'`.
*/}
<meta name="kbp:page-type" content={pageType} />
{itemName && <meta name="kbp:item-name" content={itemName} />}
{GA4_ID && <meta name="kbp:ga4-id" content={GA4_ID} />}

{GA4_ID && <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`} />}
{/* Portfolio-wide conversion events (phone_call, email_click, whatsapp_click, lead_form_submit) — served from /public so it passes the 'self' script-src. */}
{GA4_ID && <script is:inline defer src="/ga4-events.js"></script>}

<script>
  const metaContent = (name: string) =>
    document.querySelector(`meta[name="kbp:${name}"]`)?.getAttribute('content') || undefined

  const pageType = metaContent('page-type') || 'other'
  const itemName = metaContent('item-name')
  const GA4_ID = metaContent('ga4-id')

  /* The queue exists whether or not a tag is configured, so events are never
     lost to the absence of an account and can be inspected today. */
  window.dataLayer = window.dataLayer || []

  if (GA4_ID) {
    /* Google's documented snippet pushes the `arguments` object itself, and
       gtag.js reads it back in that shape. Kept verbatim rather than rewritten
       to rest parameters — this path only runs once a measurement ID exists, so
       it has never been exercised here, and it is not the place to improvise. */
    const gtag = function () {
      window.dataLayer.push(arguments)
    } as (...args: unknown[]) => void
    window.gtag = gtag
    gtag('js', new Date())
    /* Page views are sent manually below so the page type travels with them. */
    gtag('config', GA4_ID, { send_page_view: false })
  }

  function track(event: string, detail?: Record<string, unknown>) {
    const payload = Object.assign({ event: event }, detail || {})
    window.dataLayer.push(payload)
    if (typeof window.gtag === 'function') {
      window.gtag('event', event, detail || {})
    }
  }
  window.kbpTrack = track

  track('page_view', { page_type: pageType, item_name: itemName || undefined })

  if (pageType === 'product') track('product_view', { item_name: itemName })
  if (pageType === 'category') track('category_view', { item_name: itemName })

  /* One delegated listener rather than a listener per element, so adding a
     phone number or a CTA anywhere on the site needs no further wiring. */
  document.addEventListener(
    'click',
    function (e) {
      const link = e.target instanceof Element ? e.target.closest('a') : null
      if (!link) return
      const href = link.getAttribute('href') || ''

      if (href.startsWith('tel:') || href.startsWith('mailto:') || href.includes('wa.me') || href.includes('whatsapp')) {
        /* Sent as phone_call / email_click / whatsapp_click by /ga4-events.js
           (the portfolio-wide key events) — not repeated here, or GA4 would
           count each click twice. */
        return
      } else if (link.classList.contains('btn')) {
        /* The link text identifies the CTA. It is authored copy, never
           anything a visitor typed. */
        track('cta_click', {
          page_type: pageType,
          cta_text: (link.textContent || '').trim().slice(0, 60),
          destination: href,
        })
      }
    },
    { passive: true },
  )
</script>
