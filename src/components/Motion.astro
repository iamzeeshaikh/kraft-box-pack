---
/**
 * Scroll reveal, applied by adding `data-reveal` to any element.
 *
 * Three things this deliberately does not do:
 *
 *   - It does not hide content until JavaScript runs. The hidden state is set
 *     by the script itself, so with JS disabled or still loading everything is
 *     visible and readable. Animating in from `opacity: 0` in the stylesheet is
 *     what makes a page blank for users whose script never arrives.
 *   - It does not animate anything for users who ask not to be. The
 *     prefers-reduced-motion check runs before any state is applied, so those
 *     users get the finished layout immediately rather than a faster animation.
 *   - It does not observe forever. Each element is unobserved once it has
 *     revealed, so scrolling a long product grid does not keep the callback
 *     firing.
 *
 * Transform and opacity only, both compositor properties, so nothing here
 * triggers layout during a scroll.
 */
---

<style is:global>
  [data-reveal] {
    /* No initial state here on purpose — see the note above. The script adds
       .reveal-init, so content is never hidden by CSS alone. */
    transition:
      opacity 0.55s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  [data-reveal].reveal-init {
    opacity: 0;
    transform: translateY(14px);
  }

  [data-reveal].reveal-in {
    opacity: 1;
    transform: none;
  }

  /* Staggering children of a revealed group reads as one movement rather than
     several. Capped at eight so a twenty-item grid does not take two seconds. */
  [data-reveal-group] > * {
    transition:
      opacity 0.5s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  [data-reveal-group].reveal-init > * {
    opacity: 0;
    transform: translateY(12px);
  }
  [data-reveal-group].reveal-in > * {
    opacity: 1;
    transform: none;
  }
  [data-reveal-group].reveal-in > *:nth-child(1) { transition-delay: 0ms; }
  [data-reveal-group].reveal-in > *:nth-child(2) { transition-delay: 60ms; }
  [data-reveal-group].reveal-in > *:nth-child(3) { transition-delay: 120ms; }
  [data-reveal-group].reveal-in > *:nth-child(4) { transition-delay: 180ms; }
  [data-reveal-group].reveal-in > *:nth-child(5) { transition-delay: 240ms; }
  [data-reveal-group].reveal-in > *:nth-child(6) { transition-delay: 300ms; }
  [data-reveal-group].reveal-in > *:nth-child(7) { transition-delay: 360ms; }
  [data-reveal-group].reveal-in > *:nth-child(n + 8) { transition-delay: 420ms; }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    [data-reveal-group] > * {
      transition: none !important;
    }
  }

  /* Printing never scrolls, so the observer never fires and a printed page
     would come out with holes in it. */
  @media print {
    [data-reveal].reveal-init,
    [data-reveal-group].reveal-init > * {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)')

  function start() {
    const targets = document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-group]')
    if (!targets.length) return

    // Someone who has asked for reduced motion gets the finished state, not a
    // quicker animation. Nothing is hidden, so there is nothing to reveal.
    if (reduce.matches || !('IntersectionObserver' in window)) {
      targets.forEach((el) => el.classList.add('reveal-in'))
      return
    }

    targets.forEach((el) => el.classList.add('reveal-init'))

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          entry.target.classList.add('reveal-in')
          io.unobserve(entry.target)
        }
      },
      // Fires a little before the element reaches the viewport so the movement
      // has finished by the time it is properly in view.
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    )

    targets.forEach((el) => io.observe(el))

    /*
     * Failsafe. Nothing on this page may stay invisible because an animation
     * did not run.
     *
     * The observer only fires when an element enters a scrolling viewport, and
     * several things never scroll: a full-page screenshot, a crawler that
     * renders at full document height, a print stylesheet, an in-page search
     * jumping past a section. Under any of those the hidden state would stick
     * and the content would simply be gone.
     *
     * Caught this on the first build — a full-page capture rendered the whole
     * customization section as an empty panel.
     *
     * After eight seconds anything still unrevealed is revealed regardless.
     * Elements the reader has already scrolled past are unaffected; they were
     * revealed on the way.
     */
    window.setTimeout(() => {
      document
        .querySelectorAll('.reveal-init:not(.reveal-in)')
        .forEach((el) => el.classList.add('reveal-in'))
      io.disconnect()
    }, 8000)
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true })
  } else {
    start()
  }

  // Astro view transitions swap the document without a full load.
  document.addEventListener('astro:page-load', start)
</script>
