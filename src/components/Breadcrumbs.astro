---
import type { Crumb } from '../lib/schema';
interface Props { crumbs: Crumb[] }
const { crumbs } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <div class="wrap">
    <ol>
      {crumbs.map((c, i) => (
        <li>
          {i === crumbs.length - 1
            ? <span aria-current="page">{c.name}</span>
            : <a href={c.url}>{c.name}</a>}
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>
  .crumbs {
    background: var(--surface-alt);
    border-bottom: 1px solid var(--line);
    font-size: var(--step--1);
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0.6rem 0;
  }
  li { margin: 0; display: flex; align-items: center; gap: 0.5rem; }
  li + li::before {
    content: '/';
    color: var(--muted);
  }
  a { color: var(--ink-soft); text-decoration: none; }
  a:hover { color: var(--kraft-dark); text-decoration: underline; }
  [aria-current='page'] { color: var(--muted); }
</style>
