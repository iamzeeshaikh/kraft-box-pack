---
import Icon from '../Icon.astro';
import { FEATURES } from '../../data/site';
---
<section class="features" aria-labelledby="features-heading">
  <div class="wrap">
    <h2 id="features-heading" class="visually-hidden">Why order from Kraft Box Pack</h2>
    <ul role="list">
      {FEATURES.map((f) => (
        <li>
          <span class="features__icon"><Icon name={f.icon} size={26} /></span>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .features { padding-block: clamp(1.75rem, 1.4rem + 1.6vw, 3rem); }
  .features ul {
    display: grid;
    gap: var(--gap);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .features li {
    margin: 0;
    text-align: center;
    padding: 1.4rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .features__icon {
    display: inline-grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin-bottom: 0.85rem;
    border-radius: 50%;
    background: var(--green-tint);
    color: var(--green-dark);
  }
  .features h3 { font-size: var(--step-0); margin-bottom: 0.4em; }
  .features p { margin: 0; font-size: var(--step--1); color: var(--muted); }
</style>
