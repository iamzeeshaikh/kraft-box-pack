---
/**
 * What can be specified, beside the rotating box.
 *
 * The page previously said "custom" repeatedly without ever showing what was
 * actually adjustable. This lists the real options from the product
 * specification tables, with one line per group explaining what decides the
 * choice — which is the part a buyer cannot get from a dropdown.
 */
import { SPEC_GROUPS } from '../../data/home-content'
import BoxScene from './BoxScene.astro'
---

<section class="section section--alt cust" aria-labelledby="cust-heading">
  <div class="wrap cust__inner">
    <div class="cust__art" data-reveal>
      <BoxScene size="sm" />
      <p class="cust__cap">
        Every run is cut on a fresh dieline. There are no stock sizes.
      </p>
    </div>

    <div class="cust__body">
      <div class="section__head" data-reveal>
        <h2 id="cust-heading">What you actually get to choose</h2>
        <p>
          Material, print route, finish and structure are all specified per
          order. Below is what each decision turns on.
        </p>
      </div>

      <dl class="cust__list" data-reveal-group>
        {SPEC_GROUPS.map((g) => (
          <div class="cust__row">
            <dt>{g.label}</dt>
            <dd>
              <ul class="cust__chips" role="list">
                {g.options.map((o) => <li>{o}</li>)}
              </ul>
              <p>{g.note}</p>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .cust__inner {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    align-items: start;
  }

  @media (min-width: 900px) {
    /* minmax(0,…) rather than a bare fraction, so the chip rows can shrink
       instead of forcing the grid wider than the viewport. */
    .cust__inner { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
    .cust__art { position: sticky; top: 2rem; }
  }

  .cust__cap {
    text-align: center;
    color: var(--ink-soft);
    font-size: var(--step--1);
    max-width: 26ch;
    margin: 0.75rem auto 0;
  }

  .cust__list { margin: 1.5rem 0 0; }

  .cust__row {
    padding-block: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .cust__row:first-child { border-top: 0; padding-top: 0; }

  .cust__row dt {
    font-weight: 700;
    font-size: var(--step-0);
    margin-bottom: 0.55rem;
  }

  .cust__row dd { margin: 0; }

  .cust__row dd p {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
    max-width: 62ch;
  }

  .cust__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cust__chips li {
    margin: 0;
    padding: 0.28rem 0.62rem;
    font-size: var(--step--1);
    line-height: 1.4;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-soft);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .cust__chips li:hover {
    border-color: var(--kraft-light);
    color: var(--kraft-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .cust__chips li { transition: none; }
  }
</style>
