---
/**
 * The five stages of an order.
 *
 * A quote-based business asks for an enquiry without saying what happens
 * afterwards, which is the main reason a first-time buyer hesitates. Naming
 * the stages — and saying plainly that nothing prints until they approve a
 * proof — removes most of that hesitation.
 *
 * Rendered as an ordered list because it is a sequence, so it stays a sequence
 * for a screen reader too.
 */
import { PROCESS } from '../../data/home-content'
---

<section class="section proc" aria-labelledby="proc-heading">
  <div class="wrap">
    <div class="section__head" data-reveal>
      <h2 id="proc-heading">How an order runs</h2>
      <p>
        From first enquiry to delivery. Nothing goes to press until you have
        approved a proof.
      </p>
    </div>

    <ol class="proc__list" data-reveal-group>
      {PROCESS.map((s) => (
        <li class="proc__step">
          <span class="proc__n" aria-hidden="true">{s.n}</span>
          <div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .proc__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }

  /* Five stages across one row at desktop, so the sequence reads left to
     right rather than wrapping a single orphan onto a second line. */
  @media (min-width: 1180px) {
    .proc__list { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }

  .proc__step {
    position: relative;
    margin: 0;
    padding: 1.3rem 1.35rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .proc__step:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .proc__n {
    flex: none;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1;
    color: var(--kraft-light);
    font-weight: 700;
  }

  .proc__step h3 {
    margin: 0 0 0.35rem;
    font-size: var(--step-0);
    line-height: 1.3;
  }

  .proc__step p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  @media (prefers-reduced-motion: reduce) {
    .proc__step { transition: none; }
    .proc__step:hover { transform: none; }
  }
</style>
